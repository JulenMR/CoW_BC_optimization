#----------------------------------------------------------------
# General simulation parameters

Continue previous simulation: 0
Number of spatial dimensions: 3
Number of time steps: 3000
Time step size: 0.001022
Spectral radius of infinite time step: 0.20
Searched file name to trigger stop: STOP_SIM

Save results to VTK format: 1
Name prefix of saved VTK files: result
Increment in saving VTK files: 20
Start saving after time step: 1

Increment in saving restart files: 10
Convert BIN to VTK format: 0

Verbose: 1
Warning: 1
Debug: 0

#----------------------------------------------------------------
# Mesh data
Add mesh: cow{
   Mesh file path: mesh-complete/mesh-complete.mesh.vtu
   Add face: wall {
      Face file path: mesh-complete/walls_combined.vtp
   }

   Add face: R_ICA {
      Face file path: mesh-complete/mesh-surfaces/cap_R_ICA.vtp
   }

   Add face: L_ICA{
      Face file path: mesh-complete/mesh-surfaces/cap_L_ICA.vtp
   }

   Add face: R_VA {
      Face file path: mesh-complete/mesh-surfaces/cap_R_VA.vtp
   }

   Add face: L_VA {
      Face file path: mesh-complete/mesh-surfaces/cap_L_VA.vtp
   }

   Add face: L_ACA {
      Face file path: mesh-complete/mesh-surfaces/cap_L_ACA.vtp
   }

   Add face: L_MCA {
      Face file path: mesh-complete/mesh-surfaces/cap_L_MCA.vtp
   }

   Add face: L_PCA {
      Face file path: mesh-complete/mesh-surfaces/cap_L_PCA.vtp
   }

   Add face: R_PCA {
      Face file path: mesh-complete/mesh-surfaces/cap_R_PCA.vtp
   }

   Add face: L_SCA {
      Face file path: mesh-complete/mesh-surfaces/cap_L_SCA.vtp
   }

   Add face: R_ACA {
      Face file path: mesh-complete/mesh-surfaces/cap_R_ACA.vtp
   }

   Add face: R_MCA {
      Face file path: mesh-complete/mesh-surfaces/cap_R_MCA.vtp
   }

   Add face: R_SCA {
      Face file path: mesh-complete/mesh-surfaces/cap_R_SCA.vtp
   }
}

#----------------------------------------------------------------
# Equations
Add equation: fluid {
   Coupled: 1
   Min iterations: 3
   Max iterations: 10
   Tolerance: 1e-5
   Backflow stabilization coefficient: 0.2

   Density: 0.00106
   Viscosity: Constant {Value: 0.005}

   Output: Spatial {
      Velocity: t
      Pressure: t
      Traction: t
      WSS: t
   }

   LS type: NS
   {
      Max iterations: 10
      NS-GM max iterations: 3
      NS-CG max iterations: 500
      Tolerance: 1D-3
      NS-GM tolerance: 1D-3
      NS-CG tolerance: 1D-3
      Krylov space dimension: 50
   }

   Add BC: wall {
      Type: Dirichlet
      Value: 0.0
   }

   Add BC: R_ICA {
      Type: Dir
      Time dependence: Unsteady
      Temporal values file path: RICA_3d_smooth.dat
      Profile: Parabolic
      Impose flux: t
   }

   Add BC: L_ICA {
      Type: Dir
      Time dependence: Unsteady
      Temporal values file path: LICA_3d_smooth.dat
      Profile: Parabolic
      Impose flux: t
   }

   Add BC: R_VA {
      Type: Dir
      Time dependence: Unsteady
      Temporal values file path: RVA_3d_smooth.dat
      Profile: Parabolic
      Impose flux: t
   }

   Add BC: L_VA {
      Type: Dir
      Time dependence: Unsteady
      Temporal values file path: LVA_3d_smooth.dat
      Profile: Parabolic
      Impose flux: t
   }

   Add BC: L_ACA {
     Type: Neumann
     Time dependence: RCR
     RCR values: (1.1848, 0.08319071, 7.6677)
     Distal pressure: 0.0
   }

   Add BC: L_MCA {
     Type: Neumann
     Time dependence: RCR
     RCR values: (0.5205826, 0.027051, 3.6272)
     Distal pressure: 0.0
   }

   Add BC: L_PCA {
     Type: Neumann
     Time dependence: RCR
     RCR values: (2.7307, 0.03776, 18.990)
     Distal pressure: 0.0
   }

   Add BC: R_PCA {
     Type: Neumann
     Time dependence: RCR
     RCR values: (3.282066, 0.0329291, 23.582861)
     Distal pressure: 0.0
   }

   Add BC: L_SCA {
     Type: Neumann
     Time dependence: RCR
     RCR values: (5.1361307, 0.021063038, 39.60646)
     Distal pressure: 0.0
   }

   Add BC: R_ACA {
     Type: Neumann
     Time dependence: RCR
     RCR values: (1.2751, 0.068376, 8.48798)
     Distal pressure: 0.0
   }

   Add BC: R_MCA {
     Type: Neumann
     Time dependence: RCR
     RCR values: (0.564628, 0.02401, 3.85525)
     Distal pressure: 0.0
   }

   Add BC: R_SCA {
     Type: Neumann
     Time dependence: RCR
     RCR values: (5.3400, 0.020288, 41.36877)
     Distal pressure: 0.0
   }
}
